# Insights Results
@app.get("/api/insights")
def get_insights():
    try:
        query = "SELECT time, device, status FROM conditions ORDER BY time DESC LIMIT 10;"
        df = pd.read_sql(query, engine)
        
        if df.empty:
            return {"message": "No data recorded in conditions table yet."}

        prompt = f"Analyze the following recent camera logs for a fall-detection hackathon project and provide a brief safety assessment:\n\n{df.to_string()}"

        response = client.models.generate_content(
            model="gemini-flash-latest", # Use a standard model name
            contents=prompt
        )

        return {
            "recent_logs": df.to_dict(orient="records"),
            "ai_analysis": response.text
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
